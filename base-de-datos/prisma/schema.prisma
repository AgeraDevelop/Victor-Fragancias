generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          BigInt    @id @default(autoincrement())
  nombre      String?
  descripcion String?
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rol_id         BigInt?
  nombre         String?
  email          String?
  password_hash  String?
  activo         Boolean?  @default(true)
  fecha_creacion DateTime? @default(now()) @db.Timestamptz

  rol       Role?      @relation(fields: [rol_id], references: [id])
  productos Producto[]

  @@map("usuarios")
}

model Categoria {
  id        BigInt     @id @default(autoincrement())
  nombre    String?
  productos Producto[]

  @@map("categorias")
}

model Producto {
  id                BigInt    @id @default(autoincrement())
  categoria_id      BigInt?
  usuario_id        String?   @db.Uuid
  nombre            String?
  marca             String?
  imagen_url        String?
  // Imagen subida desde el Panel Admin: se guarda como bytes en la propia
  // base de datos (no como archivo en el frontend). `imagen_mime` es su
  // tipo (image/jpeg, image/png, ...). Se sirve vía /api/productos/:id/imagen.
  imagen_mime       String?
  imagen_data       Bytes?
  genero            String?
  concentracion     String?
  familia_olfativa  String?
  notas_principales String?
  tamano_ml         Int?      @db.SmallInt
  precio            Decimal?  @db.Decimal
  stock             Int?      @db.SmallInt
  destacado         Boolean?  @default(false)
  disponible        Boolean?  @default(true)
  fecha_creacion    DateTime? @default(now()) @db.Timestamptz

  categoria    Categoria?    @relation(fields: [categoria_id], references: [id])
  usuario      Usuario?      @relation(fields: [usuario_id], references: [id])
  pedido_items PedidoItem[]

  @@map("productos")
}

// ── Pedidos enviados por WhatsApp (los confirma el Panel Admin) ─────────────
model Pedido {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo             String?
  subtotal           Decimal?  @db.Decimal
  descuento          Decimal?  @db.Decimal
  envio              Decimal?  @db.Decimal
  total              Decimal?  @db.Decimal
  estado             String?   @default("pendiente")
  origen             String?   @default("whatsapp")
  fecha_creacion     DateTime? @default(now()) @db.Timestamptz
  fecha_confirmacion DateTime? @db.Timestamptz

  items PedidoItem[]

  @@map("pedidos")
}

model PedidoItem {
  id          BigInt   @id @default(autoincrement())
  pedido_id   String   @db.Uuid
  producto_id BigInt?
  nombre      String?
  marca       String?
  imagen_url  String?
  tamano_ml   Int?     @db.SmallInt
  precio      Decimal? @db.Decimal
  cantidad    Int?
  subtotal    Decimal? @db.Decimal

  pedido   Pedido    @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  producto Producto? @relation(fields: [producto_id], references: [id], onDelete: SetNull)

  @@map("pedido_items")
}
